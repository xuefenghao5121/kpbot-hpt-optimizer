{
  "version": "2023.8.2",
  "source": "lammps-2Aug2023",
  "download_url": "https://download.lammps.org/tars/lammps-2Aug2023.tar.gz",
  "packages": "KSPACE MANYBODY MOLECULE RIGID GRANULAR",
  "cxx_flags": "-O3 -ffp-contract=off -DNDEBUG",
  "stack": ["hpckit", "bisheng", "hmpi", "kml"],
  "use_jarvis_root": true,
  "cxx_compiler": "clang++",
  "binary": "lmp_mpi",
  "prefix": "$JARVIS_ROOT/software/apps/bisheng${BISHENG_VERSION}/lammps/2023.8.2",
  "launcher": "mpirun",
  "env": [
    "module purge",
    "module use software/utils/hpckit/${HPCKIT_VERSION}/HPCKit/latest/modulefiles",
    "module add bisheng/compiler${BISHENG_VERSION}/bishengmodule bisheng/hmpi${HMPI_VERSION}/release",
    "export CC=$(command -v clang)",
    "export CXX=$(command -v clang++)",
    "export FC=$(command -v flang)",
    "module use software/moduledeps/bisheng${BISHENG_VERSION}-hmpi${HMPI_VERSION}",
    "module load fftw/3.3.10",
    "module load kml"
  ],
  "cmake": [
    "-DFFTW3_INCLUDE_DIR=${JARVIS_ROOT}/software/libs/bisheng4.2.0.2-hmpi25.1.0/fftw/3.3.10/include",
    "-DFFTW3_LIBRARY=${JARVIS_ROOT}/software/libs/bisheng4.2.0.2-hmpi25.1.0/fftw/3.3.10/lib/libfftw3.a"
  ],
  "defaults": {
    "timestep": 2.0,
    "neighbor_skin": 2.0,
    "cutoff": 9.8,
    "balance": 0
  },
  "append": [{"param": "balance", "min": 1, "line": "balance 1.0 shift xyz 5 1.1"}]
}
